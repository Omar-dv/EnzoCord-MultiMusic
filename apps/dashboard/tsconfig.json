{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@enzocord/shared": [
        "../../packages/shared/src"
      ],
      "@enzocord/config": [
        "../../packages/config/src"
      ],
      "@enzocord/database": [
        "../../packages/database/src"
      ],
      "@enzocord/discord": [
        "../../packages/discord/src"
      ],
      "@enzocord/music": [
        "../../packages/music/src"
      ],
      "@enzocord/services": [
        "../../packages/services/src"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
